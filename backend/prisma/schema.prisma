// Fonte de verdade técnica: docs/agent/plan.md
// Regras de negócio:       docs/agent/spec.md v1.1
// Quiz:                    docs/agent/QUIZ.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  FACILITATOR
  PLAYER
}

enum StoreRole {
  STORE_MANAGER
  SUPPLY_MANAGER
  COMMERCIAL_MANAGER
  OPERATIONAL_MANAGER
  SERVICE_MANAGER
}

enum SessionStatus {
  SETUP
  ROUND_1_CONFIG
  ROUND_1
  RECONFIGURATION
  ROUND_2
  ROUND_3
  FINISHED
}

enum CategoryName {
  PERECIVEIS
  MERCEARIA
  ELETRO
  HIPEL
}

enum CapexType {
  SECURITY
  FREEZER
  NETWORK
  SITE
  SELF_CHECKOUT
  AUTOMATION
}

// ─────────────────────────────────────────────────────────────────────────────
// SEED / REFERÊNCIA
// Populados pelo seed.ts — nunca alterados por usuários em runtime.
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id             String       @id @default(uuid())
  name           CategoryName @unique
  unitCost       Float
  taxRate        Float // ex.: 0.12 = 12%
  breakageRate   Float // aplicado só no fim da rodada 3
  agingRate      Float // aplicado só no fim da rodada 3
  stockAvailable Int // estoque total disponível por sessão (padrão)

  sessionConfigs    SessionCategoryConfig[]
  categoryDecisions PoCategoryDecision[]
}

model CapexOption {
  id                  String    @id @default(uuid())
  name                String
  type                CapexType @unique
  acquisitionCost     Float
  downtimeFixedDays   Int // dias fixos da fórmula: diasParados = downtimeFixedDays + SLA_TABLE[serviceOps]
  monthlyLicenseDelta Float // acréscimo à licença base configurada na sessão
  maintenanceSaving   Float // FREEZER = 400; demais = 0
  slaRiskPercent      Float // probabilidade de incidente por rodada (ex.: 0.15 = 15%)

  capexDecisions PoCapexDecision[]
  slaEvents      SlaEvent[]
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH / USUÁRIO
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  passwordHash     String
  role             UserRole
  refreshTokenHash String? // armazenado hasheado; null quando não há sessão ativa
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?
  createdAt        DateTime @default(now())

  facilitatedSessions Session[]
  storeMembers        StoreMember[]
  quizAnswers         UserQuizAnswer[]
  transfers           PlayerTransfer[]
  auditLogs           AuditLog[]
  playerRoundStatuses PlayerRoundStatus[]
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // LOGIN_SUCCESS | LOGIN_FAILED | LOGOUT | TWO_FA_ENABLED | TWO_FA_VERIFIED
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// SESSÃO / JOGO
// ─────────────────────────────────────────────────────────────────────────────

model Session {
  id              String        @id @default(uuid())
  name            String
  status          SessionStatus @default(SETUP)
  facilitatorId   String
  facilitator     User          @relation(fields: [facilitatorId], references: [id])
  totalDemand     Float // demanda total da sessão distribuída entre as lojas
  initialCash     Float         @default(700000) // R$700.000 por loja; configurável pelo facilitador
  disponibilidade Int[]         @default([])

  // ── Custos operacionais configuráveis pelo facilitador ────────────────────
  // Substituem os valores hardcoded do engine — cada sessão pode ter cenários distintos.
  cashierSalary   Float @default(1000) // R$/operador de caixa por rodada
  serviceSalary   Float @default(1200) // R$/operador de serviço por rodada
  licenseCostBase Float @default(500)  // R$ base de licença de software (CAPEX adiciona delta)

  // Timer / Cronômetro da rodada atual
  timerEnabled       Boolean   @default(false)
  timerDuration      Int?
  timerStartedAt     DateTime?
  timerPausedAt      DateTime?
  elapsedBeforePause Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores              Store[]
  categoryConfigs     SessionCategoryConfig[]
  quizQuestions       QuizQuestion[]
  userQuizAnswers     UserQuizAnswer[]
  slaEvents           SlaEvent[]
  playerTransfers     PlayerTransfer[]
  roundResults        RoundResult[]
  playerRoundStatuses PlayerRoundStatus[]
}

// Sobrescreve stockAvailable padrão do Category para uma sessão específica.
model SessionCategoryConfig {
  id             String   @id @default(uuid())
  sessionId      String
  session        Session  @relation(fields: [sessionId], references: [id])
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  stockAvailable Int

  @@unique([sessionId, categoryId])
}

model Store {
  id         String   @id @default(uuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id])
  name       String
  accessCode String   @unique
  createdAt  DateTime @default(now())

  members         StoreMember[]
  plans           OperationalPlan[]
  quizAnswers     QuizAnswer[]
  userQuizAnswers UserQuizAnswer[]
  roundResults    RoundResult[]
  slaEvents       SlaEvent[]
  transfersFrom   PlayerTransfer[]  @relation("TransferFrom")
  transfersTo     PlayerTransfer[]  @relation("TransferTo")
}

model StoreMember {
  id       String    @id @default(uuid())
  storeId  String
  store    Store     @relation(fields: [storeId], references: [id])
  userId   String
  user     User      @relation(fields: [userId], references: [id])
  role     StoreRole
  joinedAt DateTime  @default(now())

  @@unique([storeId, role])
  @@unique([storeId, userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PLANO OPERACIONAL (PO)
// configVersion 1 → rodada 1 | configVersion 2 → rodadas 2 e 3
// ─────────────────────────────────────────────────────────────────────────────

model OperationalPlan {
  id               String    @id @default(uuid())
  storeId          String
  store            Store     @relation(fields: [storeId], references: [id])
  configVersion    Int
  cashierOperators Int
  serviceOperators Int
  confirmed        Boolean   @default(false)
  confirmedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  categoryDecisions PoCategoryDecision[]
  capexDecisions    PoCapexDecision[]

  @@unique([storeId, configVersion])
}

model PoCategoryDecision {
  id             String          @id @default(uuid())
  planId         String
  plan           OperationalPlan @relation(fields: [planId], references: [id])
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id])
  stockPurchased Int
  priceMargin    Float

  @@unique([planId, categoryId])
}

model PoCapexDecision {
  id            String          @id @default(uuid())
  planId        String
  plan          OperationalPlan @relation(fields: [planId], references: [id])
  capexOptionId String
  capexOption   CapexOption     @relation(fields: [capexOptionId], references: [id])
  implemented   Boolean         @default(false)

  @@unique([planId, capexOptionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// QUIZ
// ─────────────────────────────────────────────────────────────────────────────

model QuizQuestion {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  round     Int
  prompt    String
  order     Int
  createdAt DateTime @default(now())

  options     QuizOption[]
  userAnswers UserQuizAnswer[]

  @@unique([sessionId, round, order])
}

model QuizOption {
  id         String       @id @default(uuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id])
  label      String
  isCorrect  Boolean      @default(false)

  userAnswers UserQuizAnswer[]
}

model UserQuizAnswer {
  id         String       @id @default(uuid())
  sessionId  String
  session    Session      @relation(fields: [sessionId], references: [id])
  storeId    String
  store      Store        @relation(fields: [storeId], references: [id])
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id])
  optionId   String
  option     QuizOption   @relation(fields: [optionId], references: [id])
  round      Int
  isCorrect  Boolean
  answeredAt DateTime     @default(now())

  @@unique([userId, questionId, round])
}

model QuizAnswer {
  id              String   @id @default(uuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])
  round           Int
  totalQuestions  Int
  correctAnswers  Int
  scorePercentage Float
  createdAt       DateTime @default(now())

  @@unique([storeId, round])
}

// ─────────────────────────────────────────────────────────────────────────────
// ENGINE / RESULTADOS
// ─────────────────────────────────────────────────────────────────────────────

model RoundResult {
  id        String  @id @default(uuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id])
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])
  round     Int

  csat         Float
  availability Float
  basketPrice  Float
  rankScore    Int
  demandShare  Float

  grossRevenue     Float
  taxAmount        Float
  netRevenue       Float
  costOfGoods      Float
  breakageAmount   Float
  agingAmount      Float
  payrollCost      Float
  maintenanceCost  Float
  licenseCost      Float
  interestCost     Float
  slaRevenueLost   Float
  ebitda           Float
  ebitdaPercentage Float

  cashUsed  Float
  createdAt DateTime @default(now())

  @@unique([storeId, round])
}

model SlaEvent {
  id            String      @id @default(uuid())
  sessionId     String
  session       Session     @relation(fields: [sessionId], references: [id])
  storeId       String
  store         Store       @relation(fields: [storeId], references: [id])
  capexOptionId String
  capexOption   CapexOption @relation(fields: [capexOptionId], references: [id])
  round         Int
  occurred      Boolean
  daysDown      Int
  revenueLost   Float
  createdAt     DateTime    @default(now())

  @@unique([storeId, capexOptionId, round])
}

model PlayerTransfer {
  id            String    @id @default(uuid())
  sessionId     String
  session       Session   @relation(fields: [sessionId], references: [id])
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  fromStoreId   String
  fromStore     Store     @relation("TransferFrom", fields: [fromStoreId], references: [id])
  toStoreId     String
  toStore       Store     @relation("TransferTo", fields: [toStoreId], references: [id])
  role          StoreRole
  transferredAt DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTROLE DE CONCLUSÃO DA RODADA
// ─────────────────────────────────────────────────────────────────────────────

model PlayerRoundStatus {
  id            String    @id @default(uuid())
  sessionId     String
  session       Session   @relation(fields: [sessionId], references: [id])
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  round         Int
  status        String    @default("IN_PROGRESS")
  finishedAt    DateTime?
  remainingTime Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([sessionId, userId, round])
}
