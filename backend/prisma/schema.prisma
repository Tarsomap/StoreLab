generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id                String                  @id @default(uuid())
  name              CategoryName            @unique
  unitCost          Float
  taxRate           Float
  breakageRate      Float
  agingRate         Float
  stockAvailable    Int
  categoryDecisions PoCategoryDecision[]
  sessionConfigs    SessionCategoryConfig[]
}

model CapexOption {
  id                  String            @id @default(uuid())
  name                String
  type                CapexType         @unique
  acquisitionCost     Float
  downtimeFixedDays   Int
  monthlyLicenseDelta Float
  maintenanceSaving   Float
  slaRiskPercent      Float
  capexDecisions      PoCapexDecision[]
  slaEvents           SlaEvent[]
}

model User {
  id                  String              @id @default(uuid())
  name                String
  email               String              @unique
  passwordHash        String
  role                UserRole
  refreshTokenHash    String?
  createdAt           DateTime            @default(now())
  twoFactorEnabled    Boolean             @default(false)
  twoFactorSecret     String?
  auditLogs           AuditLog[]
  playerRoundStatuses PlayerRoundStatus[]
  transfers           PlayerTransfer[]
  facilitatedSessions Session[]
  storeMembers        StoreMember[]
  quizAnswers         UserQuizAnswer[]
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model Session {
  id                  String                  @id @default(uuid())
  name                String
  status              SessionStatus           @default(SETUP)
  facilitatorId       String
  totalDemand         Float
  initialCash         Float                   @default(700000)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  disponibilidade     Int[]                   @default([])
  elapsedBeforePause  Int                     @default(0)
  timerDuration       Int?
  timerEnabled        Boolean                 @default(false)
  timerPausedAt       DateTime?
  timerStartedAt      DateTime?
  baseLicenseCost     Float                   @default(1200)
  cashierSalary       Float                   @default(1000)
  maintenanceCost     Float                   @default(400)
  serviceSalary       Float                   @default(1200)
  playerRoundStatuses PlayerRoundStatus[]
  playerTransfers     PlayerTransfer[]
  quizQuestions       QuizQuestion[]
  randomEvents        RandomEvent[]
  roundResults        RoundResult[]
  facilitator         User                    @relation(fields: [facilitatorId], references: [id])
  categoryConfigs     SessionCategoryConfig[]
  slaEvents           SlaEvent[]
  stores              Store[]
  userQuizAnswers     UserQuizAnswer[]
}

model SessionCategoryConfig {
  id             String   @id @default(uuid())
  sessionId      String
  categoryId     String
  stockAvailable Int
  category       Category @relation(fields: [categoryId], references: [id])
  session        Session  @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, categoryId])
}

model Store {
  id              String            @id @default(uuid())
  sessionId       String
  name            String
  accessCode      String            @unique
  createdAt       DateTime          @default(now())
  plans           OperationalPlan[]
  transfersFrom   PlayerTransfer[]  @relation("TransferFrom")
  transfersTo     PlayerTransfer[]  @relation("TransferTo")
  quizAnswers     QuizAnswer[]
  randomEvents    RandomEvent[]
  roundResults    RoundResult[]
  slaEvents       SlaEvent[]
  session         Session           @relation(fields: [sessionId], references: [id])
  members         StoreMember[]
  userQuizAnswers UserQuizAnswer[]
}

model StoreMember {
  id       String    @id @default(uuid())
  storeId  String
  userId   String
  role     StoreRole
  joinedAt DateTime  @default(now())
  store    Store     @relation(fields: [storeId], references: [id])
  user     User      @relation(fields: [userId], references: [id])

  @@unique([storeId, role])
  @@unique([storeId, userId])
}

model OperationalPlan {
  id                String               @id @default(uuid())
  storeId           String
  configVersion     Int
  cashierOperators  Int
  serviceOperators  Int
  confirmed         Boolean              @default(false)
  confirmedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  store             Store                @relation(fields: [storeId], references: [id])
  capexDecisions    PoCapexDecision[]
  categoryDecisions PoCategoryDecision[]

  @@unique([storeId, configVersion])
}

model PoCategoryDecision {
  id             String          @id @default(uuid())
  planId         String
  categoryId     String
  stockPurchased Int
  priceMargin    Float
  category       Category        @relation(fields: [categoryId], references: [id])
  plan           OperationalPlan @relation(fields: [planId], references: [id])

  @@unique([planId, categoryId])
}

model PoCapexDecision {
  id            String          @id @default(uuid())
  planId        String
  capexOptionId String
  implemented   Boolean         @default(false)
  capexOption   CapexOption     @relation(fields: [capexOptionId], references: [id])
  plan          OperationalPlan @relation(fields: [planId], references: [id])

  @@unique([planId, capexOptionId])
}

model QuizQuestion {
  id          String           @id @default(uuid())
  sessionId   String
  round       Int
  prompt      String
  order       Int
  createdAt   DateTime         @default(now())
  options     QuizOption[]
  session     Session          @relation(fields: [sessionId], references: [id])
  userAnswers UserQuizAnswer[]

  @@unique([sessionId, round, order])
}

model QuizOption {
  id          String           @id @default(uuid())
  questionId  String
  label       String
  isCorrect   Boolean          @default(false)
  question    QuizQuestion     @relation(fields: [questionId], references: [id])
  userAnswers UserQuizAnswer[]
}

model UserQuizAnswer {
  id         String       @id @default(uuid())
  sessionId  String
  storeId    String
  userId     String
  questionId String
  optionId   String
  round      Int
  isCorrect  Boolean
  answeredAt DateTime     @default(now())
  option     QuizOption   @relation(fields: [optionId], references: [id])
  question   QuizQuestion @relation(fields: [questionId], references: [id])
  session    Session      @relation(fields: [sessionId], references: [id])
  store      Store        @relation(fields: [storeId], references: [id])
  user       User         @relation(fields: [userId], references: [id])

  @@unique([userId, questionId, round])
}

model QuizAnswer {
  id              String   @id @default(uuid())
  storeId         String
  round           Int
  totalQuestions  Int
  correctAnswers  Int
  scorePercentage Float
  createdAt       DateTime @default(now())
  store           Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, round])
}

model RoundResult {
  id               String   @id @default(uuid())
  storeId          String
  sessionId        String
  round            Int
  csat             Float
  availability     Float
  basketPrice      Float
  rankScore        Int
  demandShare      Float
  grossRevenue     Float
  taxAmount        Float
  netRevenue       Float
  costOfGoods      Float
  breakageAmount   Float
  agingAmount      Float
  payrollCost      Float
  maintenanceCost  Float
  licenseCost      Float
  interestCost     Float
  slaRevenueLost   Float
  ebitda           Float
  ebitdaPercentage Float
  cashUsed         Float
  createdAt        DateTime @default(now())
  randomEventCost  Float    @default(0)
  session          Session  @relation(fields: [sessionId], references: [id])
  store            Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, round])
}

model SlaEvent {
  id            String      @id @default(uuid())
  sessionId     String
  storeId       String
  capexOptionId String
  round         Int
  occurred      Boolean
  daysDown      Int
  revenueLost   Float
  createdAt     DateTime    @default(now())
  capexOption   CapexOption @relation(fields: [capexOptionId], references: [id])
  session       Session     @relation(fields: [sessionId], references: [id])
  store         Store       @relation(fields: [storeId], references: [id])

  @@unique([storeId, capexOptionId, round])
}

model RandomEvent {
  id         String          @id @default(uuid())
  sessionId  String
  storeId    String
  round      Int
  eventType  RandomEventType
  occurred   Boolean
  impactData Json
  createdAt  DateTime        @default(now())
  session    Session         @relation(fields: [sessionId], references: [id])
  store      Store           @relation(fields: [storeId], references: [id])

  @@unique([storeId, round, eventType])
}

model PlayerTransfer {
  id            String    @id @default(uuid())
  sessionId     String
  userId        String
  fromStoreId   String
  toStoreId     String
  role          StoreRole
  transferredAt DateTime  @default(now())
  fromStore     Store     @relation("TransferFrom", fields: [fromStoreId], references: [id])
  session       Session   @relation(fields: [sessionId], references: [id])
  toStore       Store     @relation("TransferTo", fields: [toStoreId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
}

model PlayerRoundStatus {
  id            String    @id @default(uuid())
  sessionId     String
  userId        String
  round         Int
  status        String    @default("IN_PROGRESS")
  finishedAt    DateTime?
  remainingTime Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  session       Session   @relation(fields: [sessionId], references: [id])
  user          User      @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId, round])
}

enum UserRole {
  FACILITATOR
  PLAYER
}

enum StoreRole {
  STORE_MANAGER
  SUPPLY_MANAGER
  COMMERCIAL_MANAGER
  OPERATIONAL_MANAGER
  SERVICE_MANAGER
}

enum SessionStatus {
  SETUP
  ROUND_1_CONFIG
  ROUND_1
  RECONFIGURATION
  ROUND_2
  ROUND_3
  FINISHED
}

enum CategoryName {
  PERECIVEIS
  MERCEARIA
  ELETRO
  HIPEL
}

enum CapexType {
  SECURITY
  FREEZER
  NETWORK
  SITE
  SELF_CHECKOUT
  AUTOMATION
}

enum RandomEventType {
  OPERATIONAL_FAILURE
  REGULATORY_CHANGE
  COMPETITOR_PROMOTION
  REPUTATION_DAMAGE
  LOT_CONTAMINATION
  INVENTORY_THEFT
  PAYMENT_SYSTEM_FAILURE
  CYBER_ATTACK
  DATA_BREACH
  LOGISTICS_PROBLEM
  POWER_OUTAGE
  CLIMATE_EVENT
  INPUT_COST_INCREASE
  DEMAND_SURGE
}
